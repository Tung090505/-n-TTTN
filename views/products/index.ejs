<% layout('layouts/main') %>
    <div class="container mx-auto px-6 py-10">
        <% const catMap={ 'laptop' : 'Laptop' , 'pc' : 'Máy tính bộ (PC)' , 'cpu' : 'Bộ vi xử lý (CPU)' , 'gpu'
            : 'Card đồ họa (VGA)' , 'ram' : 'Bộ nhớ (RAM)' , 'storage' : 'Ổ cứng (SSD/HDD)' , 'motherboard'
            : 'Bo mạch chủ' , 'psu' : 'Nguồn máy tính' , 'case' : 'Vỏ máy tính' , 'cooling' : 'Tản nhiệt' , 'monitor'
            : 'Màn hình' , 'keyboard' : 'Bàn phím' , 'mouse' : 'Chuột máy tính' , 'headset' : 'Tai nghe' }; const
            categories=Object.keys(catMap); %>
            <div class="flex flex-col lg:flex-row gap-6">

                <!-- SIDEBAR: FILTERS - Compact -->
                <aside class="w-full lg:w-64 space-y-6">
                    <div class="glass p-5 rounded-[1.5rem] sticky top-28 border border-white/20 shadow-xl shadow-slate-200/40">
                        <div class="flex items-center justify-between mb-5 cursor-pointer lg:cursor-default border-b border-slate-100 pb-4 lg:border-0 lg:pb-0" onclick="document.getElementById('filter-content').classList.toggle('hidden')">
                            <h2 class="text-lg font-black flex items-center gap-2 text-slate-800 tracking-tight">
                                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center shadow-md">
                                   <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                                </div>
                                Bộ Lọc
                            </h2>
                            <a href="/san-pham" class="text-[10px] font-bold text-blue-600 bg-blue-50 px-3 py-1.5 rounded-lg">Làm mới</a>
                        </div>

                        <div id="filter-content" class="hidden lg:block space-y-8">
                        <form action="/san-pham" method="GET" id="filter-form" class="space-y-8">
                            <!-- Danh mục -->
                            <div class="px-1">
                                <h3 class="text-[10px] font-black text-slate-400 mb-4 uppercase tracking-widest opacity-60 ml-2">Danh mục</h3>
                                <div class="flex flex-col gap-0.5">
                                    <% categories.forEach(cat=> { %>
                                        <label class="h-10 flex items-center cursor-pointer group px-3 rounded-xl hover:bg-slate-50 transition-all">
                                            <div class="relative w-4 h-4 mr-3">
                                                <input type="radio" name="category" value="<%= cat %>" onchange="this.form.submit()" class="hidden peer" <%=query.category===cat ? 'checked' : '' %>>
                                                <div class="w-4 h-4 border-2 border-slate-200 rounded-full peer-checked:border-blue-600 peer-checked:bg-blue-600 transition-all flex items-center justify-center">
                                                    <div class="w-1.5 h-1.5 bg-white rounded-full <%= query.category === cat ? 'block' : 'hidden' %>"></div>
                                                </div>
                                            </div>
                                            <span class="text-[13px] font-bold text-slate-600 group-hover:text-blue-600 truncate"><%= catMap[cat] %></span>
                                        </label>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- Hãng -->
                            <div class="px-1">
                                <h3 class="text-[10px] font-black text-slate-400 mb-4 uppercase tracking-widest opacity-60 ml-2">Thương hiệu</h3>
                                <div class="grid grid-cols-2 gap-2">
                                    <% const topBrands=['ASUS', 'MSI', 'Intel', 'HP', 'Dell', 'AMD'] %>
                                    <% topBrands.forEach(brand=> { %>
                                        <div class="relative">
                                            <input type="checkbox" name="brand" value="<%= brand %>" id="brand-<%= brand %>" onchange="this.form.submit()" class="hidden peer" <%=(query.brand && (Array.isArray(query.brand) ? query.brand.includes(brand) : query.brand===brand)) ? 'checked' : '' %>>
                                            <label for="brand-<%= brand %>" class="block py-2 rounded-lg border border-slate-100 text-[10px] font-bold text-center cursor-pointer hover:border-blue-200 transition-all peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600"><%= brand %></label>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>

                            <!-- Budget -->
                            <div class="bg-slate-50/50 p-4 rounded-2xl border border-slate-100">
                                <div class="flex gap-2 mb-2">
                                    <input type="number" name="price[gte]" value="<%= query.price?.gte %>" placeholder="Từ" class="w-1/2 px-2 py-2 rounded-lg bg-white border border-slate-100 outline-none text-[11px] font-bold">
                                    <input type="number" name="price[lte]" value="<%= query.price?.lte %>" placeholder="Đến" class="w-1/2 px-2 py-2 rounded-lg bg-white border border-slate-100 outline-none text-[11px] font-bold">
                                </div>
                                <button type="submit" class="w-full py-2 bg-slate-800 text-white text-[10px] font-black rounded-lg uppercase tracking-widest shadow-md">Lọc giá</button>
                            </div>
                        </form>
                        </div>
                    </div>
                </aside>

                <!-- CONTENT: PRODUCTS GRID - High Density -->
                <main class="flex-1">
                    <!-- Top Bar -->
                    <div class="flex items-center justify-between mb-6 bg-white/50 p-4 rounded-2xl border border-slate-50">
                        <div>
                            <h1 class="text-xl font-black text-slate-800 tracking-tight">
                                <%= query.category ? catMap[query.category] : 'SẢN PHẨM' %>
                            </h1>
                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5"><%= total %> kết quả</p>
                        </div>

                        <select name="sort" form="filter-form" onchange="this.form.submit()" class="bg-white border border-slate-100 rounded-lg px-3 py-1.5 text-xs font-bold outline-none shadow-sm">
                            <option value="-createdAt">Mới nhất</option>
                            <option value="price">Giá thấp</option>
                            <option value="-price">Giá cao</option>
                        </select>
                    </div>

                    <!-- Grid - 5 Columns -->
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-3">
                        <% if (products.length===0) { %>
                            <div class="col-span-full py-20 text-center">
                                <h2 class="text-slate-400 font-bold">Không tìm thấy sản phẩm</h2>
                            </div>
                            <% } %>

                                <% products.forEach(p=> { %>
                                    <article class="product-card group bg-white rounded-xl border border-slate-50 hover:border-blue-100 hover:shadow-md transition-all duration-300 relative flex flex-col h-full overflow-hidden">
                                        <div class="relative p-2 aspect-square flex items-center justify-center bg-slate-50/50">
                                            <a href="/san-pham/<%= p.slug %>" class="block w-full h-full p-2">
                                                <img src="<%= p.thumbnail %>" alt="<%= p.name %>" class="w-full h-full object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-500">
                                            </a>
                                            <button class="absolute top-2 right-2 w-6 h-6 rounded-full bg-white opacity-0 group-hover:opacity-100 flex items-center justify-center text-slate-300 hover:text-red-500 transition-all shadow-sm">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                            </button>
                                        </div>

                                        <div class="p-3 flex flex-col flex-grow bg-white">
                                            <h3 class="font-bold text-slate-800 leading-tight mb-1 group-hover:text-blue-600 transition-colors line-clamp-2 min-h-[2.2rem] text-xs">
                                                <a href="/san-pham/<%= p.slug %>"><%= p.name %></a>
                                            </h3>
                                            
                                            <% if (p.numReviews && p.numReviews > 0) { %>
                                                <div class="flex items-center gap-1 mb-2">
                                                    <div class="flex text-yellow-400 text-[9px]">
                                                        <% const rating = Math.round(p.rating || 0) %>
                                                        <%= '★'.repeat(rating) %>
                                                    </div>
                                                    <span class="text-slate-400 text-[9px] font-bold">(<%= p.numReviews %>)</span>
                                                </div>
                                            <% } %>
                                            
                                            <div class="mt-auto pt-2 flex items-center justify-between">
                                                <p class="text-blue-600 font-black text-[14px] leading-none">
                                                    <%= (p.salePrice || p.price).toLocaleString('vi-VN') %>đ
                                                </p>
                                                <button onclick="addToCart('<%= p._id %>')" class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center hover:bg-blue-600 transition-all">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"></path></svg>
                                                </button>
                                            </div>
                                        </div>
                                    </article>
                                    <% }) %>
                    </div>

                    <!-- Pagination - Small -->
                    <% if (totalPages> 1) { %>
                        <div class="mt-10 flex justify-center gap-1.5">
                            <% for(let i=1; i<=totalPages; i++) { %>
                                <a href="/san-pham?page=<%= i %><%= query.category ? '&category='+query.category : '' %><%= query.brand ? '&brand='+query.brand : '' %><%= query.sort ? '&sort='+query.sort : '' %>"
                                    class="w-9 h-9 flex items-center justify-center rounded-lg text-xs font-bold transition-all <%= currentPage === i ? 'bg-blue-600 text-white' : 'bg-white text-slate-500 hover:bg-slate-100' %>">
                                    <%= i %>
                                </a>
                                <% } %>
                        </div>
                        <% } %>
                </main>
            </div>
    </div>

    <script>
        async function addToCart(id) {
            try {
                const res = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: id, quantity: 1 })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Đã thêm sản phẩm vào giỏ hàng! ⚡');
                    window.location.reload();
                } else {
                    alert(data.message || 'Lỗi! Vui lòng thử lại.');
                }
            } catch (err) { console.error(err); }
        }

        function clearPrice() {
            const form = document.getElementById('filter-form');
            form['price[gte]'].value = '';
            form['price[lte]'].value = '';
            form.submit();
        }
    </script>