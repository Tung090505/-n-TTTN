<% layout('layouts/main') %>

<div class="container mx-auto px-6 py-10">
    <div class="flex flex-col lg:flex-row gap-8">
        <%- include('../partials/admin-sidebar', { active: 'chat' }) %>

        <main class="flex-1 space-y-8 min-h-[600px]">
            <div class="glass p-1 rounded-[2.5rem] overflow-hidden flex flex-col h-[700px]">
                <div class="flex h-full divide-x divide-slate-100">
                    <!-- Danh sách khách hàng -->
                    <div class="w-1/3 flex flex-col">
                        <div class="p-6 border-b border-slate-100 bg-white/50">
                            <h3 class="text-xl font-bold text-slate-900">Khách hàng</h3>
                            <p class="text-sm text-slate-500 font-medium">Danh sách hỗ trợ gần đây</p>
                        </div>
                        <div id="customer-list" class="flex-1 overflow-y-auto p-2 space-y-2">
                            <!-- Sẽ được đổ bằng JS -->
                            <div class="animate-pulse flex space-x-4 p-4">
                                <div class="rounded-full bg-slate-200 h-10 w-10"></div>
                                <div class="flex-1 space-y-6 py-1">
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                    <div class="h-2 bg-slate-200 rounded"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cửa sổ Chat -->
                    <div class="flex-1 flex flex-col bg-white">
                        <!-- Header Chat -->
                        <div id="chat-header" class="p-4 border-b border-slate-100 flex items-center justify-between bg-white/50 backdrop-blur-md">
                            <div class="flex items-center gap-4">
                                <div id="active-customer-avatar" class="w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center text-xl shadow-inner">👤</div>
                                <div>
                                    <h4 id="active-customer-name" class="font-bold text-slate-900">Chọn khách hàng</h4>
                                    <p id="active-customer-status" class="text-[10px] font-black uppercase tracking-widest text-slate-400">Chưa có kết nối nào</p>
                                </div>
                            </div>
                        </div>

                        <!-- Tin nhắn -->
                        <div id="chat-messages" class="flex-1 overflow-y-auto p-8 space-y-6 bg-slate-50/30">
                            <div class="flex flex-col items-center justify-center h-full text-slate-400 space-y-4">
                                <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center text-4xl shadow-xl shadow-slate-200/50">💬</div>
                                <p class="font-bold tracking-tight">Chọn một khách hàng để bắt đầu hỗ trợ</p>
                            </div>
                        </div>

                        <!-- Input -->
                        <div class="p-6 bg-white border-t border-slate-100">
                            <form id="staff-chat-form" class="flex items-center gap-4">
                                <input type="text" id="chat-input" placeholder="Nhập tin nhắn phản hồi..." 
                                    class="flex-1 px-8 py-5 rounded-[1.5rem] bg-slate-50 border-none focus:ring-2 focus:ring-slate-900 transition-all outline-none text-sm font-medium" disabled>
                                <button type="submit" id="send-btn" class="w-14 h-14 rounded-2xl bg-slate-900 text-white flex items-center justify-center shadow-2xl shadow-slate-900/40 hover:scale-105 active:scale-95 transition-all disabled:opacity-50" disabled>
                                    <svg class="w-6 h-6 transform rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>

<!-- Socket.io -->
<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const customerListEl = document.getElementById('customer-list');
    const messagesEl = document.getElementById('chat-messages');
    const chatForm = document.getElementById('staff-chat-form');
    const chatInput = document.getElementById('chat-input');
    const sendBtn = document.getElementById('send-btn');
    const activeName = document.getElementById('active-customer-name');
    const activeStatus = document.getElementById('active-customer-status');

    let currentRoom = null;
    const staffId = '<%= user._id %>';

    // Join staff room
    socket.emit('join_staff');

    async function fetchCustomerList() {
        const res = await fetch('/api/chat/customer-list');
        const data = await res.json();
        if (data.success) {
            renderCustomerList(data.customerList);
        }
    }

    function renderCustomerList(list) {
        if (list.length === 0) {
            customerListEl.innerHTML = '<div class="text-center p-10"><p class="text-slate-400 font-bold text-sm">Chưa có tin nhắn mới</p></div>';
            return;
        }
        customerListEl.innerHTML = list.map(item => {
            const isUnread = (!item.isRead && item.lastSender === 'customer');
            return `
            <div onclick="selectCustomer('${item._id}', '${item.customerInfo.lastName} ${item.customerInfo.firstName}')" 
                class="customer-item group p-5 rounded-[2rem] cursor-pointer hover:bg-white hover:shadow-xl transition-all ${currentRoom === item._id ? 'bg-white shadow-xl shadow-slate-200/50' : ''}">
                <div class="flex items-center gap-4">
                    <div class="relative w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center text-xl shadow-inner">
                        👤
                        ${isUnread ? '<div class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full border-2 border-white shadow-lg animate-bounce"></div>' : ''}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex justify-between items-start mb-1">
                            <h5 class="font-bold text-slate-900 truncate tracking-tight text-sm">${item.customerInfo.lastName} ${item.customerInfo.firstName}</h5>
                            <span class="text-[9px] font-black text-slate-300 uppercase">${new Date(item.lastTime).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>
                        </div>
                        <p class="text-xs ${isUnread ? 'text-slate-900 font-bold' : 'text-slate-400'} truncate">
                            ${item.lastSender === 'customer' ? '📩 ' : '↩️ '} ${item.lastMessage}
                        </p>
                    </div>
                </div>
            </div>
        `}).join('');
    }

    async function selectCustomer(customerId, name) {
        currentRoom = customerId;
        activeName.innerText = name;
        activeStatus.innerText = 'Đang Hỗ Trợ Trực Tuyến';
        chatInput.disabled = false;
        sendBtn.disabled = false;
        
        document.querySelectorAll('.customer-item').forEach(el => el.classList.remove('bg-white', 'shadow-xl'));
        
        const res = await fetch(`/api/chat/history/${customerId}`);
        const data = await res.json();
        if (data.success) {
            renderMessages(data.messages);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        fetch(`/api/chat/mark-read/${customerId}`, { method: 'PATCH' });
        fetchCustomerList();
    }

    function renderMessages(messages) {
        if (messages.length === 0) {
            messagesEl.innerHTML = '<p class="text-center text-slate-400">Bắt đầu cuộc trò chuyện bằng tin nhắn đầu tiên</p>';
            return;
        }
        messagesEl.innerHTML = messages.map(msg => `
            <div class="flex ${msg.senderRole === 'customer' ? 'justify-start' : 'justify-end'} animate-in fade-in slide-in-from-bottom-2 duration-300">
                <div class="max-w-[70%] p-4 rounded-[1.5rem] shadow-sm ${msg.senderRole === 'customer' ? 'bg-white text-slate-800 rounded-bl-none border border-slate-100' : 'bg-slate-900 text-white rounded-br-none shadow-xl shadow-slate-900/10'}">
                    <p class="text-sm font-medium leading-relaxed">${msg.content}</p>
                    <p class="text-[9px] mt-2 font-black uppercase opacity-40 tracking-widest text-right">${new Date(msg.createdAt).toLocaleTimeString()}</p>
                </div>
            </div>
        `).join('');
    }

    chatForm.onsubmit = (e) => {
        e.preventDefault();
        const content = chatInput.value.trim();
        if (!content || !currentRoom) return;

        socket.emit('staff_send_message', {
            senderId: staffId,
            receiverId: currentRoom,
            content: content,
            room: currentRoom,
            senderRole: '<%= user.role %>'
        });

        // Optimistic UI - Hiển thị luôn tin nhắn vừa gửi
        const msgEl = document.createElement('div');
        msgEl.className = 'flex justify-end animate-in fade-in slide-in-from-bottom-2 duration-300';
        msgEl.innerHTML = `
            <div class="max-w-[70%] p-4 rounded-[1.5rem] shadow-sm bg-slate-900 text-white rounded-br-none shadow-xl shadow-slate-900/10">
                <p class="text-sm font-medium leading-relaxed">${content}</p>
                <p class="text-[9px] mt-2 font-black uppercase opacity-40 tracking-widest text-right">${new Date().toLocaleTimeString()}</p>
            </div>
        `;
        messagesEl.appendChild(msgEl);
        messagesEl.scrollTop = messagesEl.scrollHeight;

        chatInput.value = '';
    };

    socket.on('admin_new_message', (data) => {
        const msg = data.message;
        const customerId = data.customerId;

        if (customerId === currentRoom) {
            // Không append lại nếu là tin nhắn do chính mình vừa gửi (đã xử lý ở Optimistic UI)
            if (msg.sender !== staffId) {
                const msgEl = document.createElement('div');
                msgEl.className = `flex ${msg.senderRole === 'customer' ? 'justify-start' : 'justify-end'} animate-in fade-in slide-in-from-bottom-2 duration-300`;
                msgEl.innerHTML = `
                    <div class="max-w-[70%] p-4 rounded-[1.5rem] shadow-sm ${msg.senderRole === 'customer' ? 'bg-white text-slate-800 rounded-bl-none border border-slate-100' : 'bg-slate-900 text-white rounded-br-none shadow-xl shadow-slate-900/10'}">
                        <p class="text-sm font-medium leading-relaxed">${msg.content}</p>
                        <p class="text-[9px] mt-2 font-black uppercase opacity-40 tracking-widest text-right">${new Date(msg.createdAt).toLocaleTimeString()}</p>
                    </div>
                `;
                messagesEl.appendChild(msgEl);
                messagesEl.scrollTop = messagesEl.scrollHeight;
            }
            
            // Nếu khách hàng gửi tin nhắn khi đang xem phòng này, tự động đánh dấu đã đọc
            if (msg.senderRole === 'customer') {
                fetch(`/api/chat/mark-read/${currentRoom}`, { method: 'PATCH' });
            }
        }
        fetchCustomerList();
    });

    fetchCustomerList();
</script>
