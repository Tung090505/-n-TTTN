<% layout('layouts/main') %>
    <div class="container mx-auto px-6 py-10">

        <div class="max-w-6xl mx-auto">
            <!-- Header -->
            <div class="flex items-center justify-between mb-10">
                <a href="/tai-khoan/don-hang"
                    class="text-sm font-bold text-slate-400 hover:text-blue-600 transition-colors flex items-center gap-2">
                    ← Quay lại đơn hàng
                </a>
                <div class="text-right">
                    <h1 class="text-3xl font-black text-slate-900">Đơn hàng #<%= order.orderCode %>
                    </h1>
                    <p class="text-sm text-slate-500 font-medium">Đặt ngày <%= new
                            Date(order.createdAt).toLocaleString('vi-VN') %>
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch pb-10">
                
                <!-- 1. Trạng thái đơn hàng (Left) -->
                <div class="glass p-8 rounded-[3rem] shadow-sm border border-white/40 flex flex-col hover:shadow-lg transition-all duration-500">
                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-10 h-10 bg-blue-600/10 text-blue-600 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                        </div>
                        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Hành trình</h2>
                    </div>
                    
                    <div class="space-y-6 flex-grow">
                        <% order.statusHistory.slice().reverse().forEach((history, idx)=> { %>
                            <div class="flex gap-4 relative">
                                <% if(idx < order.statusHistory.length - 1) { %>
                                    <div class="absolute left-[13px] top-8 bottom-[-24px] w-[2px] bg-slate-100"></div>
                                <% } %>
                                <div class="w-7 h-7 rounded-full border-[6px] <%= idx === 0 ? 'border-blue-600 bg-blue-100 ring-4 ring-blue-500/10' : 'border-slate-200 bg-white' %> z-10 shrink-0 transition-all duration-300"></div>
                                <div class="<%= idx === 0 ? 'bg-blue-50/50 p-4 rounded-2xl border border-blue-100/50 w-full' : '' %>">
                                    <p class="text-[11px] font-black <%= idx === 0 ? 'text-blue-600' : 'text-slate-400' %> uppercase tracking-[0.1em]">
                                        <%= history.status %>
                                    </p>
                                    <p class="text-sm text-slate-700 font-bold mt-0.5">
                                        <%= history.status === 'pending' ? 'Đã tiếp nhận' : history.note %>
                                    </p>
                                    <p class="text-[9px] text-slate-400 font-medium mt-1">
                                        <%= new Date(history.updatedAt).toLocaleDateString('vi-VN') %> • <%= new Date(history.updatedAt).toLocaleTimeString('vi-VN', {hour: '2-digit', minute:'2-digit'}) %>
                                    </p>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- 2. Kiện hàng của bạn (Middle) -->
                <div class="glass p-8 rounded-[3rem] shadow-sm border border-white/40 flex flex-col hover:shadow-lg transition-all duration-500 overflow-hidden relative">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-blue-600/5 -mr-12 -mt-12 rounded-full"></div>
                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-10 h-10 bg-indigo-600/10 text-indigo-600 rounded-xl flex items-center justify-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                        </div>
                        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Kiện hàng</h2>
                    </div>

                    <div class="space-y-4 max-h-[600px] overflow-y-auto pr-2 custom-scrollbar">
                        <% order.items.forEach(item=> { %>
                            <div class="flex items-center gap-4 p-4 rounded-[2rem] bg-slate-50 border border-slate-100/50 hover:bg-white transition-all duration-300 shadow-sm group">
                                <div class="w-16 h-16 bg-white rounded-2xl p-2 shrink-0 border border-slate-100 shadow-sm group-hover:scale-110 transition-transform">
                                    <img src="<%= item.thumbnail || '/images/default-product.webp' %>" class="w-full h-full object-contain">
                                </div>
                                <div class="flex-grow min-w-0">
                                    <h4 class="font-bold text-[13px] text-slate-800 truncate mb-1"><%= item.name %></h4>
                                    <div class="flex flex-col gap-1">
                                        <div class="flex items-center gap-2">
                                            <span class="text-[9px] font-black bg-slate-200 text-slate-500 px-1.5 py-0.5 rounded-md">x<%= item.quantity %></span>
                                            <span class="text-[11px] text-slate-400 font-medium"><%= item.price.toLocaleString('vi-VN') %>đ</span>
                                        </div>
                                        <div class="flex items-center justify-between border-t border-slate-100/50 pt-1 mt-1">
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">Thành tiền:</span>
                                            <span class="text-sm font-black text-blue-600 tracking-tight"><%= (item.price * item.quantity).toLocaleString('vi-VN') %>đ</span>
                                        </div>
                                        <% if (order.orderStatus === 'delivered' && item.product) { %>
                                            <a href="/san-pham/<%= item.product.slug %>#reviews-tab" class="mt-3 block text-center py-2 bg-white border border-blue-600 text-blue-600 text-[10px] font-black rounded-xl hover:bg-blue-600 hover:text-white transition-all shadow-sm">
                                                ★ Đánh giá ngay
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- 3. Chi tiết & QR & Tổng số (Right) -->
                <div class="flex flex-col gap-6 h-full">
                    <!-- Shipping Info & Cost -->
                    <div class="glass p-8 rounded-[3rem] shadow-sm border border-white/40">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 bg-emerald-600/10 text-emerald-600 rounded-xl flex items-center justify-center">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                            </div>
                            <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Người nhận</h2>
                        </div>
                        
                        <div class="space-y-4">
                            <div>
                                <p class="text-[10px] text-slate-400 font-black uppercase tracking-[0.1em] mb-1">Địa chỉ giao hàng</p>
                                <p class="text-sm font-bold text-slate-800 leading-tight"><%= order.shippingAddress.street %>, <%= order.shippingAddress.ward %>, <%= order.shippingAddress.district %>, <%= order.shippingAddress.city %></p>
                            </div>
                            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                                <span class="text-xs font-bold text-slate-400 uppercase">Tổng cộng:</span>
                                <span class="text-2xl font-black text-blue-600 tracking-tighter"><%= order.totalAmount.toLocaleString('vi-VN') %>đ</span>
                            </div>
                        </div>
                    </div>

                    <!-- SePay QR (At the end of the 3rd column) -->
                    <% if(sepayQR && order.paymentStatus === 'unpaid') { %>
                        <div class="relative group">
                            <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[3rem] blur opacity-10 animate-pulse"></div>
                            <div class="relative glass bg-white p-8 rounded-[3rem] shadow-xl border border-blue-500/20 text-center flex flex-col items-center">
                                <h2 class="text-sm font-bold text-slate-900 tracking-tight mb-4">Quét mã VietQR (SePay)</h2>
                                <div class="bg-white p-3 rounded-2xl shadow-inner mb-4 border border-slate-100">
                                    <img src="<%= sepayQR %>" alt="QR Code" class="w-36 h-36 object-contain">
                                </div>
                                <div class="w-full bg-slate-50 p-3 rounded-xl border border-slate-200/60 flex items-center justify-center gap-2">
                                    <span class="text-xs font-black text-blue-600"><%= order.orderCode %></span>
                                    <button onclick="navigator.clipboard.writeText('<%= order.orderCode %>'); showToast('Đã sao chép mã!');" class="p-1 text-slate-400 hover:text-blue-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <% } else if (order.paymentStatus === 'paid') { %>
                        <div class="glass p-8 rounded-[3rem] flex flex-col items-center justify-center text-center bg-emerald-50 border border-emerald-100">
                            <div class="w-12 h-12 bg-emerald-500 text-white rounded-full flex items-center justify-center mb-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                            </div>
                            <h3 class="text-sm font-black text-emerald-600 uppercase">Đã thanh toán</h3>
                        </div>
                    <% } %>
                    
                    <% if(order.orderStatus==='pending' ) { %>
                        <button onclick="cancelOrder('<%= order.orderCode %>')"
                            class="w-full py-4 rounded-2xl bg-white border-2 border-red-50 text-red-500 font-bold text-xs hover:bg-red-500 hover:text-white transition-all duration-300">
                            Hủy đơn hàng này
                        </button>
                    <% } %>
                </div>

            </div>

        </div>

    </div>

    <script>
        async function cancelOrder(code) {
            if (!confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?')) return;

            try {
                const res = await fetch(`/api/orders/my-orders/${code}/cancel`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason: 'Khách hàng hủy đơn' })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Hủy đơn hàng thành công!', 'success');
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(data.message, 'error');
                }
            } catch (err) { 
                console.error(err);
                showToast('Có lỗi xảy ra, vui lòng thử lại.', 'error');
            }
        }
    </script>