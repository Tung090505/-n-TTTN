<% layout('layouts/main') %>
    <div class="min-h-[70vh] flex items-center justify-center py-12 px-6">
        <div class="w-full max-w-md">
            <div class="glass p-10 rounded-[3rem] shadow-2xl border border-white/40">

                <div class="text-center mb-10">
                    <h1 class="text-4xl font-black text-slate-900 mb-2">Quên mật khẩu</h1>
                    <p class="text-slate-500">Nhập email của bạn để nhận liên kết đặt lại mật khẩu.</p>
                </div>

                <div id="status-msg" class="hidden mb-6 p-4 rounded-2xl">
                    <p class="text-sm font-bold leading-tight" id="msg-content"></p>
                </div>

                <form id="forgot-form" class="space-y-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 ml-1">Email tài khoản</label>
                        <input type="email" id="email" required placeholder="name@example.com"
                            class="w-full px-6 py-4 rounded-2xl bg-slate-100 border-none outline-none focus:ring-2 focus:ring-blue-500/20 focus:bg-white transition-all">
                    </div>

                    <button type="submit" id="submit-btn"
                        class="w-full py-5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl shadow-xl shadow-blue-500/20 transition-all active:scale-95 flex items-center justify-center gap-2">
                        <span id="btn-text">Gửi liên kết đặt lại</span>
                    </button>
                </form>

                <div class="mt-10 pt-10 border-t border-slate-200 text-center">
                    <p class="text-slate-500">Nhớ lại mật khẩu?
                        <a href="/dang-nhap" class="text-blue-600 font-bold hover:underline">Quay lại đăng nhập</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.getElementById('forgot-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const btn = document.getElementById('submit-btn');
            const btnText = document.getElementById('btn-text');
            const statusBox = document.getElementById('status-msg');
            const msgContent = document.getElementById('msg-content');

            // Loading state
            btn.disabled = true;
            btn.classList.add('opacity-70', 'cursor-not-allowed');
            btnText.innerText = 'Đang xử lý...';

            try {
                const res = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });
                const result = await res.json();

                statusBox.classList.remove('hidden', 'bg-red-50', 'text-red-600', 'bg-green-50', 'text-green-600');

                if (result.success) {
                    statusBox.classList.add('bg-green-50', 'text-green-600');
                    msgContent.innerText = '✓ Liên kết đặt lại mật khẩu đã được gửi đến email của bạn. Vui lòng kiểm tra hộp thư (bao gồm cả thư rác).';
                    document.getElementById('forgot-form').classList.add('hidden');
                } else {
                    statusBox.classList.add('bg-red-50', 'text-red-600');
                    msgContent.innerText = '× ' + (result.message || 'Email không tồn tại trong hệ thống.');
                    btn.disabled = false;
                    btn.classList.remove('opacity-70', 'cursor-not-allowed');
                    btnText.innerText = 'Gửi liên kết đặt lại';
                }
            } catch (err) {
                statusBox.classList.remove('hidden');
                statusBox.classList.add('bg-red-50', 'text-red-600');
                msgContent.innerText = '× Lỗi kết nối. Vui lòng thử lại sau.';
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                btnText.innerText = 'Gửi liên kết đặt lại';
            }
        });
    </script>