<% if (user && user.role === 'customer') { %>
<div id="customer-chat-widget" class="fixed bottom-6 right-6 z-50">
    <!-- Chat Button -->
    <button id="chat-toggle-btn" class="w-16 h-16 rounded-full bg-slate-900 text-white shadow-2xl flex items-center justify-center hover:scale-110 active:scale-95 transition-all shadow-slate-900/40">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
    </button>

    <!-- Chat Window -->
    <div id="chat-window" class="hidden absolute bottom-20 right-0 w-[350px] sm:w-[400px] h-[500px] bg-white rounded-[2rem] shadow-2xl flex flex-col overflow-hidden border border-slate-100 animate-in fade-in slide-in-from-bottom-5 duration-300">
        <!-- Header -->
        <div class="p-6 bg-slate-900 text-white border-b border-slate-800 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center">
                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
                    </svg>
                </div>
                <div>
                    <h3 class="font-bold text-lg">TechStore Support</h3>
                    <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Trực tuyến 24/7</p>
                </div>
            </div>
            <button onclick="toggleChat()" class="text-white/50 hover:text-white transition-all text-2xl">×</button>
        </div>

        <!-- Messages -->
        <div id="customer-chat-messages" class="flex-1 overflow-y-auto p-6 space-y-4 bg-slate-50/50">
            <!-- Messages will be here -->
        </div>

        <!-- Input Area -->
        <div class="p-4 bg-white border-t border-slate-100">
            <form id="customer-chat-form" class="flex items-center gap-3">
                <input type="text" id="customer-chat-input" placeholder="Nhập tin nhắn..." 
                    class="flex-1 px-5 py-3 rounded-2xl bg-slate-100 text-sm border-none focus:ring-2 focus:ring-slate-900 transition-all outline-none">
                <button type="submit" class="p-3 rounded-2xl bg-slate-900 text-white shadow-lg active:scale-95 transition-all">
                    <svg class="w-5 h-5 rotate-45" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const chatWidget = document.getElementById('chat-window');
    const toggleBtn = document.getElementById('chat-toggle-btn');
    const chatForm = document.getElementById('customer-chat-form');
    const chatInput = document.getElementById('customer-chat-input');
    const messagesEl = document.getElementById('customer-chat-messages');
    
    const socket = io();
    const customerId = '<%= user._id %>';
    let chatInitialized = false;

    socket.emit('join', customerId);

    function toggleChat() {
        chatWidget.classList.toggle('hidden');
        if (!chatWidget.classList.contains('hidden') && !chatInitialized) {
            loadChatHistory();
            chatInitialized = true;
        }
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    toggleBtn.onclick = toggleChat;

    async function loadChatHistory() {
        const res = await fetch(`/api/chat/history/${customerId}`);
        const data = await res.json();
        if (data.success) {
            renderCustomerMessages(data.messages);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }
    }

    function renderCustomerMessages(messages) {
        messagesEl.innerHTML = messages.map(msg => `
            <div class="flex ${msg.senderRole === 'customer' ? 'justify-end' : 'justify-start'} group animate-in slide-in-from-bottom-2 duration-300">
                <div class="max-w-[80%] px-4 py-3 rounded-2xl shadow-sm text-sm ${msg.senderRole === 'customer' ? 'bg-slate-900 text-white rounded-br-none' : 'bg-white text-slate-800 rounded-bl-none border border-slate-100'}">
                    <p class="leading-relaxed">${msg.content}</p>
                    <p class="text-[9px] mt-1 opacity-50 text-right">${new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</p>
                </div>
            </div>
        `).join('');
    }

    chatForm.onsubmit = (e) => {
        e.preventDefault();
        const content = chatInput.value.trim();
        if (!content) return;

        socket.emit('customer_send_message', {
            senderId: customerId,
            content: content,
            room: customerId
        });

        chatInput.value = '';
    };

    socket.on('new_message', (msg) => {
        const msgEl = document.createElement('div');
        msgEl.className = `flex ${msg.senderRole === 'customer' ? 'justify-end' : 'justify-start'} animate-in slide-in-from-bottom-2 duration-300`;
        msgEl.innerHTML = `
            <div class="max-w-[80%] px-4 py-3 rounded-2xl shadow-sm text-sm ${msg.senderRole === 'customer' ? 'bg-slate-900 text-white rounded-br-none' : 'bg-white text-slate-800 rounded-bl-none border border-slate-100'}">
                <p class="leading-relaxed">${msg.content}</p>
                <p class="text-[9px] mt-1 opacity-50 text-right">${new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</p>
            </div>
        `;
        messagesEl.appendChild(msgEl);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    });
</script>
<% } %>
