<!-- Flash Messages -->
<% if (success) { %>
    <div class="fixed top-24 right-6 z-[110] animate-fade-in-up">
        <div
            class="bg-emerald-500 text-white px-6 py-4 rounded-2xl shadow-xl flex items-center gap-3 border border-emerald-400/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-bold">
                <%= success %>
            </span>
        </div>
    </div>
    <% } %>
        <% if (error) { %>
            <div class="fixed top-24 right-6 z-[110] animate-fade-in-up">
                <div
                    class="bg-red-500 text-white px-6 py-4 rounded-2xl shadow-xl flex items-center gap-3 border border-red-400/20">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="font-bold">
                        <%= error %>
                    </span>
                </div>
            </div>
            <% } %>

                <script>
                    async function logout() {
                        await fetch('/api/auth/logout', { method: 'POST' });
                        window.location.href = '/dang-nhap';
                    }

                    async function loadCartCount() {
                        try {
                            const res = await fetch('/api/cart');
                            const data = await res.json();
                            if (data.success) {
                                document.getElementById('cart-count').innerText = data.data.cart.totalItems;
                            }
                        } catch (err) { }
                    }
                    document.addEventListener('DOMContentLoaded', () => {
                        if (document.getElementById('cart-count')) {
                            loadCartCount();
                        }

                        // Mobile Menu Toggle Logic
                        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
                        const closeMenuBtn = document.getElementById('close-menu-btn');
                        const mobileMenu = document.getElementById('mobile-menu');
                        const mobileMenuContent = document.getElementById('mobile-menu-content');

                        if (mobileMenuBtn && closeMenuBtn && mobileMenu) {
                            mobileMenuBtn.addEventListener('click', () => {
                                mobileMenu.style.display = 'block';
                                setTimeout(() => {
                                    mobileMenu.classList.remove('opacity-0');
                                    mobileMenuContent.classList.remove('translate-x-full');
                                }, 10);
                            });

                            const closeMenu = () => {
                                mobileMenu.classList.add('opacity-0');
                                mobileMenuContent.classList.add('translate-x-full');
                                setTimeout(() => {
                                    mobileMenu.style.display = 'none';
                                }, 300);
                            };

                            closeMenuBtn.addEventListener('click', closeMenu);
                            
                            // Close when clicking outside
                            mobileMenu.addEventListener('click', (e) => {
                                if (e.target === mobileMenu) closeMenu();
                            });
                        }
                    });
                </script>