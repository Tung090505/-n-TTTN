<% layout('layouts/main') %>
    <div class="space-y-20">

        <!-- HERO SECTION: ULTRA PREMIUM -->
        <section class="px-4 md:px-6 pt-6 md:pt-10">
            <div
                class="relative rounded-[2rem] overflow-hidden bg-gradient-to-br from-indigo-900 via-blue-900 to-slate-900 text-white min-h-[450px] md:min-h-[600px] flex items-center shadow-2xl">
                <!-- Background Animated Shapes -->
                <div class="absolute inset-0 z-0 overflow-hidden">
                    <div
                        class="absolute top-[-20%] left-[-10%] w-[50%] h-[60%] bg-blue-500/30 rounded-full blur-[100px] animate-pulse">
                    </div>
                    <div class="absolute bottom-[-20%] right-[-10%] w-[60%] h-[70%] bg-cyan-500/20 rounded-full blur-[120px] animate-pulse"
                        style="animation-delay: 2s"></div>
                    <div class="absolute top-[30%] left-[40%] w-[30%] h-[40%] bg-indigo-500/20 rounded-full blur-[80px] animate-pulse"
                        style="animation-delay: 1.5s"></div>    
                </div>

                <div
                    class="container mx-auto px-6 md:px-16 relative z-10 flex flex-col md:flex-row items-center justify-between">
                    <div class="max-w-2xl py-8 md:py-16 text-center md:text-left mt-8 md:mt-0">
                        <span
                            class="inline-block px-5 py-2 mb-6 text-xs md:text-sm font-bold tracking-wider text-cyan-200 uppercase bg-white/10 rounded-full border border-white/20 backdrop-blur-md shadow-lg animate-fade-in-up">
                            🚀 NỀN TẢNG BÁN LẺ & AI BUILD PC
                        </span>
                        <h1 class="text-4xl sm:text-5xl md:text-7xl font-black text-white mb-6 leading-tight animate-fade-in-up font-heading"
                            style="animation-delay: 0.1s">
                            Xây Dựng Cấu Hình <br class="hidden sm:block">
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-400">
                                Chuẩn Phong Cách
                            </span>
                        </h1>
                        <p class="text-base md:text-xl text-slate-300 mb-8 md:mb-12 max-w-xl mx-auto md:mx-0 leading-relaxed animate-fade-in-up font-medium"
                            style="animation-delay: 0.2s">
                            Hàng ngàn linh kiện chính hãng sẵn sàng. Trải nghiệm hệ thống <span class="text-cyan-400 font-bold">AI Builder</span> độc quyền hỗ trợ lắp ráp chuyên nghiệp và giao hàng siêu tốc 2H.
                        </p>
                        <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-4 animate-fade-in-up" style="animation-delay: 0.3s">
                            <a href="/san-pham"
                                class="px-8 py-4 bg-white hover:bg-slate-100 text-indigo-900 font-black rounded-2xl transition-all shadow-[0_0_40px_rgba(255,255,255,0.3)] hover:shadow-[0_0_60px_rgba(255,255,255,0.5)] hover:-translate-y-1">
                                Khám Phá Ngay
                            </a>
                            <a href="/build-pc"
                                class="px-8 py-4 bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white font-black rounded-2xl transition-all shadow-[0_0_40px_rgba(6,182,212,0.4)] border border-white/10 flex items-center justify-center gap-2 hover:-translate-y-1">
                                <svg class="w-6 h-6 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg> Thử Ngay AI Builder
                            </a>
                        </div>
                    </div>

                    <!-- Floating Graphic -->
                    <div class="hidden lg:block relative z-10 animate-fade-in-up p-8" style="animation-delay: 0.4s">
                        <img src="https://images.unsplash.com/photo-1587202372775-e229f172b9d7?q=80&w=600&auto=format&fit=crop"
                            alt="Gaming PC"
                            class="w-96 h-96 rounded-full drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] transform -rotate-12 hover:rotate-0 transition-transform duration-700 hover:scale-105 object-cover object-center border-4 border-white/10">
                    </div>
                </div>
            </div>
        </section>

        <!-- FEATURES: TRUST & QUALITY -->
        <section class="container mx-auto px-4 md:px-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
                <div
                    class="bg-white border border-slate-100 shadow-sm p-6 rounded-2xl flex items-start gap-4 hover:shadow-md transition-shadow">
                    <div
                        class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z">
                            </path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-800 mb-1">Chính Hãng 100%</h3>
                        <p class="text-slate-500 text-sm">TechStore cam kết mọi sản phẩm bán ra đều đầy đủ hóa đơn,
                            chứng từ.</p>
                    </div>
                </div>
                <div
                    class="bg-white border border-slate-100 shadow-sm p-6 rounded-2xl flex items-start gap-4 hover:shadow-md transition-shadow">
                    <div
                        class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-800 mb-1">Giao Hàng Thần Tốc</h3>
                        <p class="text-slate-500 text-sm">Hỗ trợ lắp ráp cài đặt và giao hàng nội thành siêu tốc 2h.</p>
                    </div>
                </div>
                <div
                    class="bg-white border border-slate-100 shadow-sm p-6 rounded-2xl flex items-start gap-4 hover:shadow-md transition-shadow">
                    <div
                        class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center flex-shrink-0">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1a2 2 0 002-2v-4a2 2 0 00-2-2H4m17 2a3 3 0 00-3 3h-1a2 2 0 00-2-2v-4a2 2 0 002-2h3">
                            </path>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-800 mb-1">Hỗ Trợ Kỹ Thuật 24/7</h3>
                        <p class="text-slate-500 text-sm">Đội ngũ chuyên gia luôn sẵn sàng giải đáp và khắc phục sự cố.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CATEGORIES: SMART SELECTION -->
        <section class="container mx-auto px-4 md:px-6 py-6 md:py-10 border-t border-slate-100/50 mt-10">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 md:mb-8 gap-2">
                <div>
                    <h2 class="text-2xl font-bold mb-1 text-slate-800 uppercase tracking-tight">Danh Mục Linh Kiện</h2>
                    <p class="text-slate-500 text-sm">Đầy đủ mọi linh kiện để lắp ráp bộ PC mơ ước</p>
                </div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                <% const svgIcon=(path)=> `<svg class="w-8 h-8 text-current" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="${path}"></path>
                    </svg>`;
                    const cats=[
                    { name: 'Laptop', slug: 'laptop', icon: svgIcon(`M21 16V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8M3 16h18a2 2
                    0 012 2v2a2 2 0 01-2 2H3a2 2 0 01-2-2v-2a2 2 0 012-2z`), color: 'text-indigo-600' },
                    { name: 'CPU', slug: 'cpu', icon: svgIcon(`M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7
                    19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z`), color:
                    'text-blue-600' },
                    { name: 'VGA / GPU', slug: 'gpu', icon: svgIcon(`M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4
                    10h16v11H4V10z`), color: 'text-emerald-600' },
                    { name: 'RAM', slug: 'ram', icon: svgIcon(`M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002
                    2h10a2 2 0 002-2V8m-9 4h4`), color: 'text-orange-600' },
                    { name: 'SSD / HDD', slug: 'storage', icon: svgIcon(`M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0
                    2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4`),
                    color: 'text-rose-600' },
                    { name: 'Màn hình', slug: 'monitor', icon: svgIcon(`M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5
                    17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z`), color: 'text-cyan-600' }
                    ];
                    %>
                    <% cats.forEach(c=> { %>
                        <a href="/san-pham?category=<%= c.slug %>"
                            class="group bg-white/50 backdrop-blur-sm border border-slate-100 hover:border-blue-300 rounded-[1.5rem] p-4 md:p-6 text-center transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/10 hover:-translate-y-2">
                            <div
                                class="w-14 h-14 md:w-16 md:h-16 mx-auto rounded-2xl bg-white shadow-sm flex items-center justify-center <%= c.color %> mb-3 md:mb-4 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300">
                                <%- c.icon %>
                            </div>
                            <span class="font-bold text-sm text-slate-700 group-hover:text-blue-600 transition-colors">
                                <%= c.name %>
                            </span>
                        </a>
                        <% }) %>
            </div>
        </section>

        <!-- FEATURED PRODUCTS -->
        <section id="featured"
            class="container mx-auto px-6 py-10 bg-slate-50/50 mt-10 rounded-t-[3rem] border-t border-slate-100">
            <div class="flex flex-col md:flex-row items-baseline justify-between mb-8 gap-4">
                <h2 class="text-2xl font-bold uppercase text-slate-800 tracking-tight flex items-center gap-2">
                    <svg class="w-6 h-6 text-red-500" fill="currentColor" viewBox="0 0 24 24">
                        <path
                            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z">
                        </path>
                    </svg>
                    Sản Phẩm Đang Hot
                </h2>
                <a href="/san-pham"
                    class="text-sm font-semibold text-blue-600 hover:text-blue-800 transition-colors flex items-center gap-1">Xem
                    tất cả <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg></a>
            </div>
            <div id="featured-products" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <% if (featuredProducts && featuredProducts.length > 0) { %>
                    <% featuredProducts.forEach(p => { %>
                        <article class="product-card group bg-white rounded-[2rem] p-6 border border-slate-100 shadow-sm hover:shadow-xl transition-all relative flex flex-col h-full hover:border-blue-200">
                            <div class="absolute top-5 right-5 z-20">
                                <button class="w-9 h-9 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-red-500 hover:bg-red-50 transition-colors shadow-sm">
                                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                                </button>
                            </div>
                            
                            <a href="/san-pham/<%= p.slug %>" class="block mb-6 overflow-hidden rounded-2xl bg-slate-50/50 p-6 aspect-square flex items-center justify-center group-hover:bg-blue-50/30 transition-colors">
                                <img src="<%= p.thumbnail %>" alt="<%= p.name %>" class="max-w-full max-h-full object-contain mix-blend-multiply group-hover:scale-110 transition-transform duration-700">
                            </a>
                  
                            <div class="flex-grow px-2">
                                <div class="flex items-center gap-2 mb-3">
                                    <span class="px-2 py-0.5 rounded-md bg-slate-100 text-[10px] font-bold text-slate-500 uppercase tracking-wider"><%= p.brand %></span>
                                    <% if (p.isNewArrival) { %>
                                        <span class="px-2 py-0.5 rounded-md badge-new text-[10px] font-bold text-white uppercase tracking-wider">MỚI</span>
                                    <% } %>
                                </div>
                                <h3 class="font-bold text-slate-900 leading-snug mb-3 group-hover:text-blue-600 transition-colors line-clamp-2 min-h-[3rem] text-sm md:text-base">
                                    <a href="/san-pham/<%= p.slug %>"><%= p.name %></a>
                                </h3>
                                
                                <% if (p.numReviews && p.numReviews > 0) { %>
                                    <div class="flex items-center gap-2 mb-4">
                                       <div class="flex text-yellow-400 text-[11px]">
                                          <% const rating = Math.round(p.rating || 0) %>
                                          <%= '★'.repeat(rating) %><%= '☆'.repeat(5 - rating) %>
                                       </div>
                                       <span class="text-slate-400 text-[11px] font-medium">(<%= p.numReviews || 0 %>)</span>
                                    </div>
                                <% } %>
                            </div>
                  
                            <div class="flex items-center justify-between pt-5 border-t border-slate-50 mt-auto px-2">
                                <div>
                                    <p class="text-red-600 font-black text-xl md:text-2xl leading-none">
                                        <%= (p.salePrice || p.price).toLocaleString('vi-VN') %>đ
                                    </p>
                                    <% if (p.salePrice && p.salePrice < p.price) { %>
                                        <p class="text-slate-400 line-through text-[11px] font-bold mt-1">
                                            <%= p.price.toLocaleString('vi-VN') %>đ
                                        </p>
                                    <% } %>
                                </div>
                                <button onclick="addToCart('<%= p._id %>')" class="w-11 h-11 md:w-13 md:h-13 rounded-2xl bg-slate-900 border border-slate-900 text-white flex items-center justify-center hover:bg-blue-600 hover:border-blue-600 transition-all shadow-md active:scale-95">
                                   <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"></path></svg>
                                </button>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-full py-20 text-center">
                        <div class="w-20 h-20 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-10 h-10 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path></svg>
                        </div>
                        <p class="text-slate-500 font-medium">Chưa có sản phẩm nào được hiển thị.</p>
                    </div>
                <% } %>
            </div>
        </section>

        <!-- NEWSLETTER -->
        <section class="container mx-auto px-4 md:px-6 py-12 md:py-16">
            <div
                class="p-8 md:p-16 rounded-[2rem] md:rounded-[3rem] bg-gradient-to-br from-indigo-900 to-purple-900 overflow-hidden relative shadow-[0_20px_50px_rgba(88,28,135,0.3)] border border-purple-500/20">
                <div class="absolute inset-0 z-0">
                    <svg class="absolute right-[-10%] bottom-[-20%] opacity-10 w-96 h-96 text-white"
                        fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0L0 12l12 12 12-12L12 0z" />
                    </svg>
                    <div class="absolute top-0 right-0 w-64 h-64 bg-pink-500/20 rounded-full blur-[80px]"></div>
                </div>
                <div class="relative z-10 max-w-2xl mx-auto rounded-2xl bg-white/5 backdrop-blur-md border border-white/10 p-6 md:p-10 text-center">
                    <h2 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight">Cập Nhật Ưu Đãi</h2>
                    <p class="text-indigo-100 mb-8 max-w-lg mx-auto text-sm md:text-base opacity-90">Nhận ngay mã giảm giá 10% cho đơn hàng đầu tiên khi đăng ký bản tin tại TechStore.</p>
                    <form class="flex flex-col sm:flex-row gap-3">
                        <input type="email" placeholder="Nhập địa chỉ email..."
                            class="flex-1 px-6 py-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 text-white placeholder-indigo-200 focus:outline-none focus:ring-4 focus:ring-purple-400/50 focus:bg-white/20 transition-all">
                        <button
                            class="px-8 py-4 bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-400 hover:to-purple-400 text-white font-black rounded-2xl transition-all shadow-lg active:scale-95 whitespace-nowrap">
                            Gửi Ngay
                        </button>
                    </form>
                </div>
            </div>
        </section>

    </div>

    <script>
        async function addToCart(id) {
            try {
                const res = await fetch('/api/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: id, quantity: 1 })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Đã thêm sản phẩm vào giỏ hàng!', 'success');
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast(data.message || 'Vui lòng đăng nhập!', 'error');
                }
            } catch (err) { showToast('Lỗi thêm sản phẩm', 'error'); }
        }
    </script>