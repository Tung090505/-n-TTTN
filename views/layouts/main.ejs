<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <meta name="description" content="TechStore - Mua laptop, PC, linh kiện máy tính chính hãng giá tốt nhất">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- CSS -->
  <!-- Thêm tệp Tailwind local để dự phòng chống rớt mạng -->
  <script src="/js/tailwind.js"></script>
  <!-- Link CDN dự phòng -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    h1,
    h2,
    h3,
    .font-heading {
      font-family: 'Outfit', sans-serif;
    }

    .text-gradient {
      background: linear-gradient(to right, #3b82f6, #6366f1);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    @keyframes toast-in {
      from {
        opacity: 0;
        transform: translateX(100%) scale(0.9);
      }
      to {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }
    .animate-toast-in {
      animation: toast-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-slate-50 min-h-screen flex flex-col">
  <%- include('../partials/navbar') %>

    <main class="flex-grow">
      <%- body %>
    </main>

    <%- include('../partials/footer') %>

      <!-- Global Notification System -->
      <div id="toast-container" class="fixed top-24 right-6 z-[9999] flex flex-col gap-4 max-w-sm w-full"></div>

      <!-- Hidden Data for Flash Messages (Prevents Linter Errors) -->
      <div id="flash-messages" data-success="<%= locals.success || '' %>" data-error="<%= locals.error || '' %>">
      </div>

      <script>
        function showToast(message, type = 'success') {
          if (!message) return;
          const container = document.getElementById('toast-container');
          
          const iconSuccess = `<svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
          const iconError = `<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`;
          
          const toast = document.createElement('div');
          toast.className = `group relative bg-white/90 backdrop-blur-xl border border-white/50 p-5 rounded-[2rem] shadow-2xl flex items-center gap-4 transition-all duration-500 animate-toast-in hover:-translate-y-1`;
          
          const icon = type === 'success' ? iconSuccess : iconError;
          const title = type === 'success' ? 'Thành công' : 'Lỗi hệ thống';
          
          toast.innerHTML = `
                <div class="${type === 'success' ? 'bg-emerald-50' : 'bg-red-50'} p-3 rounded-2xl flex-shrink-0">
                    ${icon}
                </div>
                <div class="flex-1 pr-6">
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-400 mb-0.5">${title}</p>
                    <p class="text-[13px] font-bold text-slate-800 leading-snug">${message}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="absolute top-4 right-4 text-slate-300 hover:text-slate-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;
          
          container.appendChild(toast);
          
          // Auto remove
          setTimeout(() => {
            if(toast.parentElement) {
                toast.classList.add('opacity-0', 'scale-90', 'translate-x-[150%]');
                setTimeout(() => toast.remove(), 500);
            }
          }, 4500);
        }

        // Handle flash messages safely
        const flashData = document.getElementById('flash-messages');
        const successMessage = flashData.dataset.success;
        const errorMessage = flashData.dataset.error;

        if (successMessage) showToast(successMessage, 'success');
        if (errorMessage) showToast(errorMessage, 'error');

        // Check for specific query params (like registration success)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('registered')) {
          showToast('Đăng ký thành công! Chào mừng bạn gia nhập TechStore. ✨', 'success');
        }
      </script>
    <%- include('../partials/chat-box') %>
</body>

</html>