<!DOCTYPE html>
<html lang="vi">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <meta name="description" content="TechStore - Mua laptop, PC, linh kiện máy tính chính hãng giá tốt nhất">

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- CSS -->
  <!-- Thêm tệp Tailwind local để dự phòng chống rớt mạng -->
  <script src="/js/tailwind.js"></script>
  <!-- Link CDN dự phòng -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/style.css">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    h1,
    h2,
    h3,
    .font-heading {
      font-family: 'Outfit', sans-serif;
    }

    .text-gradient {
      background: linear-gradient(to right, #3b82f6, #6366f1);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    @keyframes toast-in {
      from {
        opacity: 0;
        transform: translateX(100%) scale(0.9);
      }
      to {
        opacity: 1;
        transform: translateX(0) scale(1);
      }
    }
    .animate-toast-in {
      animation: toast-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body class="bg-slate-50 min-h-screen flex flex-col">
  <%- include('../partials/navbar') %>

    <main class="flex-grow">
      <%- body %>
    </main>

    <%- include('../partials/footer') %>

      <!-- Global Notification System -->
      <div id="toast-container" class="fixed top-24 right-6 z-[9999] flex flex-col gap-4 max-w-sm w-full"></div>

      <!-- Hidden Data for Flash Messages (Prevents Linter Errors) -->
      <div id="flash-messages" data-success="<%= locals.success || '' %>" data-error="<%= locals.error || '' %>">
      </div>

      <script>
        function showToast(message, type = 'success') {
          if (!message) return;
          const container = document.getElementById('toast-container');
          
          const iconSuccess = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>`;
          const iconError = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>`;
          
          const toast = document.createElement('div');
          toast.className = `group relative bg-white border border-slate-200 p-4 rounded-2xl shadow-xl flex items-center gap-4 transition-all duration-500 animate-toast-in hover:shadow-2xl`;
          
          const icon = type === 'success' ? iconSuccess : iconError;
          const title = type === 'success' ? 'Thành công' : 'Lỗi hệ thống';
          
          toast.innerHTML = `
                <div class="flex-shrink-0 ${type === 'success' ? 'text-emerald-500' : 'text-red-500'}">
                    ${icon}
                </div>
                <div class="flex-1 pr-6">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-slate-400 mb-0.5">${title}</p>
                    <p class="text-[13px] font-bold text-slate-800 leading-snug">${message}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="absolute top-4 right-4 text-slate-300 hover:text-slate-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;
          
          container.appendChild(toast);
          
          // Auto remove
          setTimeout(() => {
            if(toast.parentElement) {
                toast.classList.add('opacity-0', 'scale-90', 'translate-x-[150%]');
                setTimeout(() => toast.remove(), 500);
            }
          }, 4500);
        }

        // Handle flash messages safely
        const flashData = document.getElementById('flash-messages');
        const successMessage = flashData.dataset.success;
        const errorMessage = flashData.dataset.error;

        if (successMessage) showToast(successMessage, 'success');
        if (errorMessage) showToast(errorMessage, 'error');

        // Check for specific query params (like registration success)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('registered')) {
          showToast('Đăng ký thành công! Chào mừng bạn gia nhập TechStore.', 'success');
        }
      </script>
    <%- include('../partials/chat-box') %>
    
    <!-- Socket.io Real-time Notifications -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
      const currentUserId = '<%= locals.user ? locals.user._id : "" %>';
      
      if (currentUserId) {
        const socket = io({ transports: ['websocket'] });
        
        // Đảm bảo chỉ join room sau khi đã kết nối thành công
        socket.on('connect', () => {
          socket.emit('join', currentUserId);
          console.log('Socket.io: Successfully connected and joined room:', currentUserId);
        });

        // Lắng nghe sự kiện thanh toán thành công
        socket.on('payment_success', (data) => {
          showToast(data.message, 'success');
          // Chuyển hướng về trang lịch sử đơn hàng
          setTimeout(() => {
            window.location.href = '/tai-khoan/don-hang';
          }, 2000);
        });

        socket.on('connect_error', (err) => {
          console.error('Socket.io Connection Error:', err);
        });
      }
    </script>
</body>

</html>